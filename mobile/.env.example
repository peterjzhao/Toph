# Copy to mobile/.env (gitignored). The shared demo API must be enabled on this server.
# Local DEBUG builds may use http://127.0.0.1:3000 (iOS) or http://10.0.2.2:3000 (Android).
EXPO_PUBLIC_TOPH_API_URL=https://toph-rho.vercel.app
# Match TOPH_TRANSCRIPTION_DEV_TOKEN on the server. This is a local prototype token,
# visible in the app bundle, not production authentication or an OpenAI key.
# Leave empty for Vercel: hosted transcription remains disabled.
EXPO_PUBLIC_TOPH_TRANSCRIPTION_TOKEN=
