# Toph backend configuration. Copy to .env.local (git-ignored) and fill in real values.
# Database and OpenAI credentials are server-only. Never prefix them with NEXT_PUBLIC_.

# Runtime connection used by the Next.js app: restricted application role (toph_app).
# Local Docker example: postgresql://toph_app:toph_app_local_dev_password@127.0.0.1:54329/toph
# Supabase transaction pooler example (port 6543): postgresql://toph_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Migration/seed connection with DDL privileges (schema owner). Use a direct or session
# connection, not the transaction pooler.
# Local/operator tooling only: never add this or either TEST_DATABASE_* key to Vercel.
# Local Docker example: postgresql://toph_owner:toph_owner_local_dev_password@127.0.0.1:54329/toph
# Supabase example (session pooler, port 5432): postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_MIGRATION_URL=

# Separate disposable database for backend integration tests. Tests refuse to run when this
# points at the runtime database. The database name must contain "test".
# Local Docker example: postgresql://toph_owner:toph_owner_local_dev_password@127.0.0.1:54329/toph_test
TEST_DATABASE_URL=

# Optional: same test database as the restricted runtime role, used only to verify grants.
# Local Docker example: postgresql://toph_app:toph_app_local_dev_password@127.0.0.1:54329/toph_test
TEST_DATABASE_APP_URL=

# Name of the restricted runtime role that `npm run db:migrate` grants privileges to.
# Leave empty to skip grants (for example when DATABASE_URL uses the owner role).
DATABASE_APP_ROLE=toph_app

# Optional PEM file for verifying a hosted database certificate (Supabase "SSL certificate").
# Remote connections always verify TLS; local loopback connections use no TLS.
# On Vercel set this to certs/supabase-prod-ca-2021.crt (included in the server bundle).
# Absolute paths on your Mac are only valid locally. See docs/deployment.md.
DATABASE_SSL_CA_PATH=

# Optional: maximum pooled connections per server process (default 5).
# Use 1 for the Vercel deployment with Supabase's transaction pooler.
DATABASE_POOL_MAX=

# The farm this deployment serves. Resolved on the server for every request; missing answers 503.
TOPH_FARM_ID=00000000-0000-4000-8000-000000000001
# Browser Origin required on POST/PATCH/DELETE requests (CSRF guard).
# Vercel Production: https://toph-rho.vercel.app (no trailing slash).
APP_ORIGIN=http://127.0.0.1:3000

# Shared farm profiles and log sync. This does not provide user authentication.
# Run db:migrate and db:enable-mobile before enabling.
TOPH_MOBILE_ENABLED=false

# Speech-to-text and structured work-log fields; server-only, including on Vercel.
# No OpenAI key or transcription token belongs in mobile/.env.
OPENAI_API_KEY=
TOPH_TRANSCRIPTION_ENABLED=false
