# Copy to .env.local and fill in. Everything here is server-only except NEXT_PUBLIC_*.
# See docs/backend/setup.md and docs/deployment.md.

# --- Database ---------------------------------------------------------------

# Runtime connection (restricted toph_app role), Supabase transaction pooler:
# postgresql://toph_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Owner connection for migrations, seeding and db:reset-sample. Never on Vercel.
# Supabase session pooler: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_MIGRATION_URL=

# Role that `npm run db:migrate` grants runtime privileges to. Empty skips grants.
DATABASE_APP_ROLE=toph_app

# CA certificate for the hosted database (committed in certs/).
DATABASE_SSL_CA_PATH=certs/supabase-prod-ca-2021.crt

# Max pooled connections per server process (default 5, use 1 on Vercel).
DATABASE_POOL_MAX=

# Backend tests run against the disposable Docker database (npm run test:db:up).
TEST_DATABASE_URL=postgresql://toph_owner:toph_owner_local_dev_password@127.0.0.1:54329/toph_test
TEST_DATABASE_APP_URL=postgresql://toph_app:toph_app_local_dev_password@127.0.0.1:54329/toph_test

# --- App --------------------------------------------------------------------

# Origin that POST/PATCH/DELETE requests must come from.
APP_ORIGIN=http://127.0.0.1:3000

# Farm used by operator scripts such as db:check. Signed-in requests use the account's farm.
TOPH_FARM_ID=00000000-0000-4000-8000-000000000001

# Turns on the /api/mobile/v1 routes used by the phone app.
TOPH_MOBILE_ENABLED=false

# Transcription and log-field extraction.
OPENAI_API_KEY=

# Optional URL for the in-browser field detection model.
# Defaults to /models/delineate-v2-512-fp32.onnx (not committed).
NEXT_PUBLIC_FIELD_MODEL_URL=
